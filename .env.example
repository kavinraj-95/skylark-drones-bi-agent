# ---------------------------------------------------------------------------
# monday.com  (required)
# ---------------------------------------------------------------------------
# Personal API token: monday.com -> avatar (bottom-left) -> Developers -> My access tokens
#
# NOTE ON READ-ONLY: monday personal tokens are not independently scoped per
# application - they inherit the permissions of the owning user. This app enforces
# read-only at the application level (defence-in-depth, not a security boundary):
# MondayClient exposes only read methods and there is no public arbitrary-query API.
# For a true server-side guarantee, use a view-only monday user's token, or an
# OAuth app scoped to boards:read.
MONDAY_API_TOKEN=

# Board IDs. Leave blank to auto-discover by name using the *_BOARD_NAME vars below.
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_NAME=Deals
MONDAY_WORK_ORDERS_BOARD_NAME=Work Orders

# monday API version to pin. Versions rotate quarterly (yyyy-mm).
MONDAY_API_VERSION=2026-07

# ---------------------------------------------------------------------------
# LLM  (required)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
# Free-tier rate limits vary by model and project - check AI Studio for yours.
# Google may use free-tier content to improve its products; this app therefore
# sends only aggregated AnalysisResult data to the LLM, never raw board rows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only when LLM_PROVIDER=anthropic. A Claude Pro/Max *subscription* does NOT work
# here - this must be a Claude Platform (console.anthropic.com) API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Seconds to reuse a fetched dataset before re-querying monday.com.
DATA_TTL_SECONDS=900
# Fiscal year start month. 4 = April (Indian FY; evidenced by SDPL/FY25-26 invoice numbers).
FISCAL_YEAR_START_MONTH=4
